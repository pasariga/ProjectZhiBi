# Copy this file to .env and fill in your own keys.
# You can also set these values as system environment variables.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

BAIDU_OCR_API_KEY=your_baidu_ocr_api_key_here
BAIDU_OCR_SECRET_KEY=your_baidu_ocr_secret_key_here

ENABLE_LOCAL_FALLBACK=true

# Optional: domestic/intranet resource search API.
# Leave empty to use the built-in curated resource fallback.
ENABLE_ONLINE_RESOURCE_SEARCH=true
SEARCH_PROVIDER=custom
SEARCH_API_KEY=
SEARCH_API_URL=
SEARCH_RESULT_LIMIT=5
